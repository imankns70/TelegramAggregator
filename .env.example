# Backend hosting environment: Npgsql format, not postgresql:// URI.
ConnectionStrings__DefaultConnection=Host=YOUR_ENDPOINT-pooler.REGION.aws.neon.tech;Database=neondb;Username=YOUR_ROLE;Password=YOUR_PASSWORD;SSL Mode=VerifyFull;Maximum Pool Size=10;Timeout=30
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
Database__ApplyMigrations=false
Worker__FetchEnabled=true
Worker__PublishingEnabled=false
Logging__DatabaseEnabled=false
# Required only when enabling publishing:
FootbalForiSettings__BotToken=
FootbalForiSettings__ChannelId=-1003358234804
# Netlify build environment only. Never put database or Telegram secrets on the frontend.
API_BASE_URL=https://YOUR_BACKEND_HOST
